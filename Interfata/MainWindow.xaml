<Window x:Class="POO_Proiect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Playlist Manager"
        Height="520" Width="820"
        Background="#2B0033">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#4B145F"
                CornerRadius="15"
                Padding="15"
                Margin="5">
            <StackPanel>
                <TextBlock Text="🎵 My Playlist"
                           Foreground="#FFB7E6"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <ListBox Height="360"
                         Background="#3A0A4F"
                         Foreground="White"
                         BorderBrush="#FF6EC7">
                    <ListBoxItem>Die for you – The Weekend</ListBoxItem>
                    <ListBoxItem>Blinding Lights – The Weeknd</ListBoxItem>
                    <ListBoxItem>Levitating – Dua Lipa</ListBoxItem>
                    <ListBoxItem>After Hours – The Weeknd</ListBoxItem>
                </ListBox>
            </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Background="#5E177E"
                CornerRadius="15"
                Padding="15"
                Margin="5">

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Now Playing"
                           Foreground="#FFD1F0"
                           FontSize="16"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Die for you – The Weekend"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,0,0,25"/>

                <Button Content="▶ Play"
                        Background="#FF6EC7"
                        Foreground="Black"
                        Height="40"
                        Margin="5"
                        

                        />
                

                <Button Content="⏭ Next"
                        Background="#E056FD"
                        Foreground="White"
                        Height="40"
                        Margin="5"/>

                <Button Content="🔀 Shuffle"
                        Background="#C77DFF"
                        Foreground="White"
                        Height="40"
                        Margin="5"/>

                <Separator Margin="15"/>

                <Button Content="➕ Add Song"
                        Background="#FF9CEE"
                        Height="35"
                        Margin="5"/>

                <Button Content="🗑 Remove Song"
                        Background="#FF5D8F"
                        Height="35"
                        Margin="5"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
